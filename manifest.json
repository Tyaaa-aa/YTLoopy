{
  "manifest_version": 3,
  "name": "YTLoopy",
  "version": "1.1.1",
  "key": "",
  "description": "Loop, slow down and bookmark sections of YouTube videos. Built for practising music.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open YTLoopy library",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "permissions": ["storage", "unlimitedStorage", "sidePanel"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/guard.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/loader.js"],
      "css": ["src/content/page.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/*", "src/shared/*", "icons/*"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
